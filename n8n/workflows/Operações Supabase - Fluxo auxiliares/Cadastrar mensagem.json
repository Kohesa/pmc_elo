    {
      "parameters": {
        "jsCode": "const rawPayload = $('Edit Fields').first().json.payload;\nconst obj = typeof rawPayload === 'string' ? JSON.parse(rawPayload) : { ...rawPayload };\n\nlet token = $('Iniciar sessão').first().json.data;\ntoken = String(token ?? '').trim();\n\n// Se vier com aspas extras, remove\ntoken = token.replace(/^\"|\"$/g, '');\n\n// Se vier duplamente escapado no início (\\\\x...), normaliza para \\x...\ntoken = token.replace(/^\\\\\\\\x/, '\\\\x');\n\nobj.p_sessao_token = token;\n\nreturn [{ payload: obj }];\n"
      },
