      "id": "3a37b719-30ec-46cf-be27-59814d7aec31",
      "name": "Reservar serviços pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -340,
        220
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "wgdTATUiaucUGp5O",
          "name": "Supabase local - Elo Connect"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const entrada = $input.first()?.json ?? {};\nlet dados = entrada.data ?? entrada;\n\nif (typeof dados === 'string') {\n  const texto = dados.trim();\n  dados = texto ? JSON.parse(texto) : [];\n}\n\nconst servicos = (Array.isArray(dados) ? dados : (dados?.servico_id ? [dados] : []))\n  .map(item => ({\n    servico_id: String(item.servico_id || '').trim(),\n    descricao_busca: String(item.descricao_busca || '').trim(),\n    tentativa: Number(item.tentativa || 0)\n  }))\n  .filter(item => item.servico_id && item.descricao_busca);\n\nif (servicos.length === 0) {\n  return [{ json: { sem_pendentes: true, quantidade_reservada: 0, servicos: [], inputs: [] } }];\n}\n\nreturn [{\n  json: {\n    sem_pendentes: false,\n    quantidade_reservada: servicos.length,\n    servicos,\n    inputs: servicos.map(item => item.descricao_busca)\n  }\n}];"
      },
      "id": "eaf5ca34-31d3-4fbb-adc5-7f3f98b86f75",
      "name": "Preparar lote reservado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "13c0e485-5976-4170-a628-4e09f3fa9d54",
              "leftValue": "={{ $json.sem_pendentes }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e20e26f1-763c-4ea6-b790-7a20169f413a",
      "name": "If - fila esgotada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        140,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'openai/text-embedding-3-small', dimensions: 384, input: $json.inputs } }}",
        "options": {}
      },
      "id": "437db643-aa1d-47a3-9853-c41646a9b64e",
      "name": "Gerar embeddings do lote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        620,
        440
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "openRouterApi": {
          "id": "oKqp4vNNKw0DgTNr",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lote = $('Preparar lote reservado').item.json;\nconst resposta = $json || {};\nconst embeddings = Array.isArray(resposta.data) ? resposta.data : [];\n\nif (!Array.isArray(lote.servicos) || lote.servicos.length === 0) {\n  throw new Error('Lote de serviços ausente.');\n}\nif (embeddings.length !== lote.servicos.length) {\n  throw new Error(`OpenRouter retornou ${embeddings.length} embeddings para ${lote.servicos.length} serviços.`);\n}\n\nconst porIndice = new Map(embeddings.map(item => [Number(item.index), item.embedding]));\nconst itens = lote.servicos.map((servico, index) => {\n  const embedding = porIndice.get(index);\n  if (!Array.isArray(embedding) || embedding.length !== 384) {\n    throw new Error(`Embedding inválido para o serviço ${servico.servico_id}.`);\n  }\n  return {\n    servico_id: servico.servico_id,\n    descricao_busca: servico.descricao_busca,\n    embedding\n  };\n});\n\nreturn { json: { itens, quantidade: itens.length } };"
      },
