        "method": "POST",
        "url": "={{ ($env.N8N_SUPABASE_URL_Elo || '').replace(/\\/+$/, '') + '/rest/v1/rpc/rpc_reservar_servicos_indexacao_pendentes_s2s' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_token_s2s: $json.data, p_limite: 25 } }}",
