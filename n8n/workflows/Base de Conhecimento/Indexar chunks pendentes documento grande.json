    {
      "parameters": {
        "jsCode": "// ALTERACAO DOCUMENTO GRANDE\n// Retorna ao fluxo principal somente quando nao ha mais chunks pendentes.\n// O fluxo principal finaliza status_indexacao=indexado e gera o indice contextual.\n\nconst input = $('When Executed by Another Workflow').first().json;\n\nreturn [{\n  json: {\n    documento_id: input.documento_id,\n    auth_user_id: input.auth_user_id,\n    qtd_chunks: Number(input.qtd_chunks || 0),\n    embedding_model: 'text-embedding-3-small',\n    gerar_indice_contextual: true,\n    limite_amostra_indice_contextual: 15\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        912
      ],
