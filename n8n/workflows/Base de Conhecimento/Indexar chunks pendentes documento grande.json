      "name": "Sticky Note",
      "notesInFlow": true,
      "notes": "ALTERADO: documenta a nova relistagem por lotes ate zerar pendentes."
    },
    {
      "parameters": {
        "content": "## Indexar micro-lote\n\nCada item do loop contem ate 50 chunks. O fluxo gera embeddings direto na OpenAI em uma chamada e salva todos em uma RPC.",
        "height": 304,
        "width": 1536,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -208,
        1136
      ],
      "typeVersion": 1,
      "id": "267ecbc6-c578-4867-9e9c-15286dea3a93",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "// ALTERACAO BATCH EMBEDDING\n// A RPC lista ate 100 chunks pendentes. Este node agrupa esses chunks em\n// micro-lotes de 50 para gerar embeddings direto na OpenAI e salvar no banco em lote.\n\nconst entrada = $('When Executed by Another Workflow').first().json;\nconst TAMANHO_MICRO_LOTE = 50;\n\nconst chunks = $input.all()\n  .map(item => item.json || {})\n  .filter(item => item.id && item.conteudo);\n\nif (chunks.length === 0) {\n  return [{\n    json: {\n      sem_pendentes: true,\n      documento_id: entrada.documento_id,\n      auth_user_id: entrada.auth_user_id,\n      qtd_chunks: Number(entrada.qtd_chunks || 0),\n      embedding_model: 'text-embedding-3-small',\n      gerar_indice_contextual: true,\n      limite_amostra_indice_contextual: 15\n    }\n  }];\n}\n\nconst lotes = [];\n\nfor (let i = 0; i < chunks.length; i += TAMANHO_MICRO_LOTE) {\n  const lote = chunks.slice(i, i + TAMANHO_MICRO_LOTE);\n\n  lotes.push({\n    json: {\n      sem_pendentes: false,\n      documento_id: entrada.documento_id,\n      auth_user_id: entrada.auth_user_id,\n      lote_index: Math.floor(i / TAMANHO_MICRO_LOTE),\n      tamanho_micro_lote: TAMANHO_MICRO_LOTE,\n      total_chunks_recebidos: chunks.length,\n      chunks: lote.map(chunk => ({\n        id: chunk.id,\n        documento_id: chunk.documento_id,\n        chunk_index: chunk.chunk_index,\n        conteudo: chunk.conteudo,\n        conteudo_hash: chunk.conteudo_hash,\n        token_count: chunk.token_count\n      }))\n    }\n  });\n}\n\nreturn lotes;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
