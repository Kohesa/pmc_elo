      "id": "eb5ee404-f0eb-4fc8-bd52-3dd130ce3150",
      "name": "Loop Over Items - chunks pendentes",
      "notesInFlow": true,
      "notes": "ALTERADO: apesar do nome, agora cada item deste loop e um micro-lote com ate 10 chunks."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ALTERACAO OPENAI EMBEDDINGS\n// Junta o retorno da OpenAI Embeddings API com o micro-lote original.\n// Saida: 1 item contendo todos os embeddings do lote para salvar via RPC batch.\n\nconst lote = $('Loop Over Items - chunks pendentes').item.json;\nconst response = $json;\nconst data = Array.isArray(response?.data) ? response.data : [];\n\nif (!Array.isArray(lote?.chunks) || lote.chunks.length === 0) {\n  throw new Error('Micro-lote original ausente para anexar embeddings.');\n}\n\nif (data.length !== lote.chunks.length) {\n  throw new Error(`OpenAI retornou ${data.length} embeddings para ${lote.chunks.length} chunks.`);\n}\n\nconst embeddingsPorIndex = new Map(data.map(item => [item.index, item.embedding]));\n\nconst chunks = lote.chunks.map((chunk, index) => {\n  const embedding = embeddingsPorIndex.get(index);\n\n  if (!Array.isArray(embedding)) {\n    throw new Error(`Embedding invalido no chunk pendente ${chunk.chunk_index}.`);\n  }\n\n  if (embedding.length !== 384) {\n    throw new Error(\n      `Embedding com dimensao invalida no chunk pendente ${chunk.chunk_index}: esperado 384, recebido ${embedding.length}.`\n    );\n  }\n\n  return {\n    chunk_pendente_id: chunk.id,\n    embedding\n  };\n});\n\nreturn {\n  json: {\n    documento_id: lote.documento_id,\n    auth_user_id: lote.auth_user_id,\n    lote_index: lote.lote_index,\n    qtd_chunks_lote: chunks.length,\n    embedding_model: 'text-embedding-3-small',\n    total_tokens_embedding: response?.usage?.total_tokens || 0,\n    chunks\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        1248
      ],
