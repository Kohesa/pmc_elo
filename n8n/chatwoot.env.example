# Chatwoot -> n8n. Não versione valores reais.
# Necessário para a validação HMAC no Code node. Libera somente o módulo nativo usado.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Supabase local acessado pelo container do n8n.
N8N_SUPABASE_URL=http://host.docker.internal:54321
N8N_CLIENT_ID_SUPABASE=
N8N_CLIENT_SECRET_SUPABASE=

N8N_CHATWOOT_BASE_URL=https://chatbot.kohesa.com.br
N8N_CHATWOOT_API_TOKEN=
N8N_CHATWOOT_WEBHOOK_SECRET=
N8N_CHATWOOT_ACCOUNT_ID=

# IDs das inboxes aceitas, separados por vírgula. Inclua agora a inbox do widget
# e acrescente a inbox do WhatsApp quando ela for habilitada.
N8N_CHATWOOT_INBOX_IDS=

# Opcional: ID do AgentBot. Quando preenchido, somente conversas atribuídas a
# esse bot continuam no fluxo. Vazio permite o processamento sem esse filtro.
N8N_CHATWOOT_AGENT_BOT_ID=

# Necessário somente quando a inbox de WhatsApp for habilitada.
N8N_WHATSAPP_BUSINESS_PHONE_NUMBER=

